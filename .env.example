# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in Resend (use "Name <email>" format)
RESEND_FROM_EMAIL=NallGeeks <onboarding@resend.dev>

# Admin inbox for new contact-form enquiries
CONTACT_TO_EMAIL=contact@nallgeeks.com

# Admin panel session signing secret (use at least 32 random characters; required in production)
ADMIN_SESSION_SECRET=

# Optional persistent administrator-store path. Defaults to data/admin-users.json.
# Provision/reset accounts with hidden password prompts:
#   npm run provision:admins -- --account izzah
#   npm run provision:admins -- --account fawaz
#   npm run provision:admins -- --account both
# ADMIN_ACCOUNTS_FILE=
